{"chunk_id": "pol-2438e8920b97cfb5dd847549e78abcc8", "document_id": "DEMO-DELIVERY-INVESTIGATION", "policy_id": "DEMO-DELIVERY-INVESTIGATION", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Delivery investigation handling for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S01", "section_title": "Synthetic demo rule", "intents_json": "[\"delivery_delay\", \"delivery_dispute\", \"non_delivery\", \"partial_delivery\"]", "categories_json": "[\"all\"]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-DELIVERY-INVESTIGATION/1.0.0", "source_path": "knowledge_base/policies/DEMO-DELIVERY-INVESTIGATION/1.0.0.md", "source_file_sha256": "802a36afd1f7ad41fc70617cb272b358b351579354a8f059b2fc1d5e810201d3", "content_sha256": "", "content": "This is fictional training content for the development fixture. It is not a retailer policy and is not approved for customer-facing use."}
{"chunk_id": "pol-1b7a18e466d0a3fd9c564cef91b1ea45", "document_id": "DEMO-DELIVERY-INVESTIGATION", "policy_id": "DEMO-DELIVERY-INVESTIGATION", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Delivery investigation handling for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S02", "section_title": "Handling", "intents_json": "[\"delivery_delay\", \"delivery_dispute\", \"non_delivery\", \"partial_delivery\"]", "categories_json": "[\"all\"]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-DELIVERY-INVESTIGATION/1.0.0", "source_path": "knowledge_base/policies/DEMO-DELIVERY-INVESTIGATION/1.0.0.md", "source_file_sha256": "802a36afd1f7ad41fc70617cb272b358b351579354a8f059b2fc1d5e810201d3", "content_sha256": "", "content": "Report only the order status and delivery events returned by an authorized read tool. Include the source timestamp. If the estimated delivery date has passed but no delivery event confirms receipt, propose an investigation or ask for the missing reference. Do not promise a delivery date, refund, or compensation.\n\nIf the source records show a delivered event while the customer reports non-receipt, state that the records conflict and route the case for human review. A delivered scan is evidence of a scan, not proof that the customer received the parcel."}
{"chunk_id": "pol-d3001aabde5128fbfc7f0aff04b4fa04", "document_id": "DEMO-LOYALTY-LEDGER", "policy_id": "DEMO-LOYALTY-LEDGER", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Loyalty ledger investigation for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S01", "section_title": "Recorded points balance", "intents_json": "[\"loyalty_points\", \"reward_expiry\", \"reward_redemption\"]", "categories_json": "[\"loyalty\", \"rewards\"]", "related_policy_ids_json": "[\"DEMO-LOYALTY-LEDGER\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-LOYALTY-LEDGER/1.0.0", "source_path": "knowledge_base/policies/DEMO-LOYALTY-LEDGER/1.0.0.md", "source_file_sha256": "b6385f7c9abeb7a406432650a48bd13e7e34fe2366af16eabd72dbd2d2abfe08", "content_sha256": "", "content": "Report only the points balance and transactions returned by the authorized loyalty ledger. Include the ledger snapshot time and identify pending or reversed events. A ticket message, order total, or customer tier is not proof that points were earned."}
{"chunk_id": "pol-ba142edb8b19d76265f93abde37c05ed", "document_id": "DEMO-LOYALTY-LEDGER", "policy_id": "DEMO-LOYALTY-LEDGER", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Loyalty ledger investigation for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S02", "section_title": "Expiry questions", "intents_json": "[\"loyalty_points\", \"reward_expiry\", \"reward_redemption\"]", "categories_json": "[\"loyalty\", \"rewards\"]", "related_policy_ids_json": "[\"DEMO-LOYALTY-LEDGER\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-LOYALTY-LEDGER/1.0.0", "source_path": "knowledge_base/policies/DEMO-LOYALTY-LEDGER/1.0.0.md", "source_file_sha256": "b6385f7c9abeb7a406432650a48bd13e7e34fe2366af16eabd72dbd2d2abfe08", "content_sha256": "", "content": "Report a recorded expiration date only when it appears in the ledger. This draft does not define an extension, reinstatement, or eligibility rule. If a customer asks for a policy decision, route the case to an authorized support reviewer."}
{"chunk_id": "pol-4ebadfb3a08a8caf8693523cebee10b0", "document_id": "DEMO-LOYALTY-LEDGER", "policy_id": "DEMO-LOYALTY-LEDGER", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Loyalty ledger investigation for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S03", "section_title": "Reward redemption", "intents_json": "[\"loyalty_points\", \"reward_expiry\", \"reward_redemption\"]", "categories_json": "[\"loyalty\", \"rewards\"]", "related_policy_ids_json": "[\"DEMO-LOYALTY-LEDGER\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-LOYALTY-LEDGER/1.0.0", "source_path": "knowledge_base/policies/DEMO-LOYALTY-LEDGER/1.0.0.md", "source_file_sha256": "b6385f7c9abeb7a406432650a48bd13e7e34fe2366af16eabd72dbd2d2abfe08", "content_sha256": "", "content": "Report the recorded redemption status and reward reference from the ledger. This draft does not authorize a redemption, points adjustment, reinstatement, or compensation. Eligibility and any balance change require an approved policy and authorized human review."}
{"chunk_id": "pol-6a5decf971bd562c9b1ac1731a44e4c1", "document_id": "DEMO-REFUND-STATUS", "policy_id": "DEMO-REFUND-STATUS", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Refund status reporting for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S01", "section_title": "Synthetic demo rule", "intents_json": "[\"refund_status\", \"late_refund\", \"compensation_request\"]", "categories_json": "[\"all\"]", "related_policy_ids_json": "[\"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-REFUND-STATUS/1.0.0", "source_path": "knowledge_base/policies/DEMO-REFUND-STATUS/1.0.0.md", "source_file_sha256": "96f4f4e3163a8fa7bda91d4252ce76b98cb2580f3582de71b93365d72c2f93ab", "content_sha256": "", "content": "This is fictional workflow guidance for the development fixture. It does not promise a processing time or monetary outcome."}
{"chunk_id": "pol-c5419ac9aa3344d21fc2642dd3583a68", "document_id": "DEMO-REFUND-STATUS", "policy_id": "DEMO-REFUND-STATUS", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Refund status reporting for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S02", "section_title": "Handling", "intents_json": "[\"refund_status\", \"late_refund\", \"compensation_request\"]", "categories_json": "[\"all\"]", "related_policy_ids_json": "[\"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-REFUND-STATUS/1.0.0", "source_path": "knowledge_base/policies/DEMO-REFUND-STATUS/1.0.0.md", "source_file_sha256": "96f4f4e3163a8fa7bda91d4252ce76b98cb2580f3582de71b93365d72c2f93ab", "content_sha256": "", "content": "Report only the refund status returned by an authorized source, together with its source timestamp. If no refund record is available, say that the record was not found and route the case for review. Keep status lookup separate from refund eligibility.\n\nThe assistant may draft a proposal for review. It must not issue, approve, or claim that a refund or compensation has been executed."}
{"chunk_id": "pol-49a8a98a82b0980f6ca8ba85abe8a643", "document_id": "DEMO-RETURN-ELIGIBILITY", "policy_id": "DEMO-RETURN-ELIGIBILITY", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Item-specific return evidence for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S01", "section_title": "Synthetic demo rule", "intents_json": "[\"return_eligibility\", \"damaged_item\", \"incorrect_item\", \"exchange_request\"]", "categories_json": "[\"all\"]", "related_policy_ids_json": "[\"DEMO-RETURN-ELIGIBILITY\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-RETURN-ELIGIBILITY/1.0.0", "source_path": "knowledge_base/policies/DEMO-RETURN-ELIGIBILITY/1.0.0.md", "source_file_sha256": "765f8ae248803b509b5d1e24129126e437cc850a9ed3cf757d66a7f940cff863", "content_sha256": "", "content": "This is fictional training content for the development fixture. It does not state a real marketplace return window or entitlement."}
{"chunk_id": "pol-20ca4848e5f14003ab641cce1a68d672", "document_id": "DEMO-RETURN-ELIGIBILITY", "policy_id": "DEMO-RETURN-ELIGIBILITY", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Item-specific return evidence for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S02", "section_title": "Handling", "intents_json": "[\"return_eligibility\", \"damaged_item\", \"incorrect_item\", \"exchange_request\"]", "categories_json": "[\"all\"]", "related_policy_ids_json": "[\"DEMO-RETURN-ELIGIBILITY\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-RETURN-ELIGIBILITY/1.0.0", "source_path": "knowledge_base/policies/DEMO-RETURN-ELIGIBILITY/1.0.0.md", "source_file_sha256": "765f8ae248803b509b5d1e24129126e437cc850a9ed3cf757d66a7f940cff863", "content_sha256": "", "content": "Do not answer yes or no from product category alone. First verify the authorized order item, marketplace, item attributes, purchase date, and an approved policy version in scope for that item and date. If any required evidence is missing, return insufficient evidence and route the case for human review.\n\nDo not treat a ticket label, generated fixture field, search score, or model output as a policy decision."}
{"chunk_id": "pol-cf84e17bcd5bdb24ec92aa6ba7f37de1", "document_id": "DEMO-RETURN-ELIGIBILITY", "policy_id": "DEMO-RETURN-ELIGIBILITY", "policy_version": "1.0.0", "artifact_type": "policy", "title": "Item-specific return evidence for the synthetic fixture", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S03", "section_title": "When an order item is reported damaged", "intents_json": "[\"return_eligibility\", \"damaged_item\", \"incorrect_item\", \"exchange_request\"]", "categories_json": "[\"all\"]", "related_policy_ids_json": "[\"DEMO-RETURN-ELIGIBILITY\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-RETURN-ELIGIBILITY/1.0.0", "source_path": "knowledge_base/policies/DEMO-RETURN-ELIGIBILITY/1.0.0.md", "source_file_sha256": "765f8ae248803b509b5d1e24129126e437cc850a9ed3cf757d66a7f940cff863", "content_sha256": "", "content": "Use this synthetic workflow when a customer says an item arrived damaged, broken, or defective. Confirm the caller is authorized to discuss the order and identify the specific order item. Record the customer's description as a report; do not treat a delivery scan, product category, or the fixture's condition field as proof that damage did or did not occur. Request only the evidence required by the approved policy that applies to the marketplace, item, and purchase date. If that policy or required evidence is unavailable, explain that eligibility cannot be confirmed from the available information and route the case for human review. Do not promise or initiate a return, replacement, refund, or compensation from this draft guidance."}
{"chunk_id": "pol-53ab8e83c2723495763fd169734b1b8f", "document_id": "DEMO-SUPPORT-FAQ", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "faq", "title": "DEMO-SUPPORT-FAQ", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S01", "section_title": "Synthetic demo FAQ", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\", \"DEMO-RETURN-ELIGIBILITY\", \"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-SUPPORT-FAQ/1.0.0", "source_path": "knowledge_base/faqs/DEMO-SUPPORT-FAQ/1.0.0.md", "source_file_sha256": "8aea7ab628cc471ea5031cd048c43f8734e108edf53007187a1ba76bb8f7db25", "content_sha256": "", "content": "This FAQ is fictional support-workflow training content. It is not a retailer's official answer and must not be presented as one."}
{"chunk_id": "pol-c5d9084238e78a81785f00fae3b63eab", "document_id": "DEMO-SUPPORT-FAQ", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "faq", "title": "DEMO-SUPPORT-FAQ", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S02", "section_title": "Where is my order?", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\", \"DEMO-RETURN-ELIGIBILITY\", \"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-SUPPORT-FAQ/1.0.0", "source_path": "knowledge_base/faqs/DEMO-SUPPORT-FAQ/1.0.0.md", "source_file_sha256": "8aea7ab628cc471ea5031cd048c43f8734e108edf53007187a1ba76bb8f7db25", "content_sha256": "", "content": "The assistant can report the order status and the latest delivery event available in the authorized record. It should include when that record was checked and ask for the order reference if it cannot safely find the order."}
{"chunk_id": "pol-76058238cfa35a9eb98022b8806ad9fd", "document_id": "DEMO-SUPPORT-FAQ", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "faq", "title": "DEMO-SUPPORT-FAQ", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S03", "section_title": "Tracking says delivered, but I did not receive the parcel", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\", \"DEMO-RETURN-ELIGIBILITY\", \"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-SUPPORT-FAQ/1.0.0", "source_path": "knowledge_base/faqs/DEMO-SUPPORT-FAQ/1.0.0.md", "source_file_sha256": "8aea7ab628cc471ea5031cd048c43f8734e108edf53007187a1ba76bb8f7db25", "content_sha256": "", "content": "The assistant should report the recorded delivery scan, explain that the report and scan conflict, and route the case for review. It must not claim that the customer received the parcel."}
{"chunk_id": "pol-4d51706a89794ec0749b25394d08a27d", "document_id": "DEMO-SUPPORT-FAQ", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "faq", "title": "DEMO-SUPPORT-FAQ", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S04", "section_title": "Can I return this item?", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\", \"DEMO-RETURN-ELIGIBILITY\", \"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-SUPPORT-FAQ/1.0.0", "source_path": "knowledge_base/faqs/DEMO-SUPPORT-FAQ/1.0.0.md", "source_file_sha256": "8aea7ab628cc471ea5031cd048c43f8734e108edf53007187a1ba76bb8f7db25", "content_sha256": "", "content": "The assistant needs the authorized order item and an approved policy version that applies to the marketplace, item, and purchase date. If that evidence is missing, it should not promise a return or refund."}
{"chunk_id": "pol-a26d7205d3df44fe356e7bdf38673706", "document_id": "DEMO-SUPPORT-FAQ", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "faq", "title": "DEMO-SUPPORT-FAQ", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S05", "section_title": "My item arrived damaged", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\", \"DEMO-RETURN-ELIGIBILITY\", \"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-SUPPORT-FAQ/1.0.0", "source_path": "knowledge_base/faqs/DEMO-SUPPORT-FAQ/1.0.0.md", "source_file_sha256": "8aea7ab628cc471ea5031cd048c43f8734e108edf53007187a1ba76bb8f7db25", "content_sha256": "", "content": "If an item arrived damaged, broken, or defective, ask which order item is affected and what damage the customer observed. Verify the caller's access before reading order details, then check the item record and the approved policy for that marketplace, item, and purchase date. Ask for additional evidence only when that policy requires it. If the applicable policy or required evidence is missing, explain that a support specialist needs to review the case. Do not promise a return, replacement, refund, or compensation based on a damage report alone."}
{"chunk_id": "pol-8aa4265d9796b374a1445779a9aa9fc5", "document_id": "DEMO-SUPPORT-FAQ", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "faq", "title": "DEMO-SUPPORT-FAQ", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "S06", "section_title": "Where is my refund?", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[\"DEMO-DELIVERY-INVESTIGATION\", \"DEMO-RETURN-ELIGIBILITY\", \"DEMO-REFUND-STATUS\"]", "source_uri": "synthetic://agentic-customer-support/DEMO-SUPPORT-FAQ/1.0.0", "source_path": "knowledge_base/faqs/DEMO-SUPPORT-FAQ/1.0.0.md", "source_file_sha256": "8aea7ab628cc471ea5031cd048c43f8734e108edf53007187a1ba76bb8f7db25", "content_sha256": "", "content": "The assistant can report the status shown in the authorized return/refund record. A status check does not determine eligibility for another refund or guarantee when money will arrive."}
{"chunk_id": "pol-c41754bf61544df6926658e860be492f", "document_id": "DEMO-EVIDENCE-GAPS", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "escalation_rule", "title": "DEMO-EVIDENCE-GAPS", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "C01", "section_title": "Caller not authorized for order", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[]", "source_uri": "synthetic://agentic-customer-support/DEMO-EVIDENCE-GAPS/1.0.0", "source_path": "knowledge_base/escalation_rules/DEMO-EVIDENCE-GAPS/1.0.0.yaml", "source_file_sha256": "de3b2dd76fe3c31f2b21fa60778b60780cf5840e58eb4eabc02b332ed9c4251f", "content_sha256": "", "content": "Condition: caller not authorized for order. Required action: deny without record lookup."}
{"chunk_id": "pol-052ce69e5b2cca3b0af99f11a33388d4", "document_id": "DEMO-EVIDENCE-GAPS", "policy_id": "", "policy_version": "1.0.0", "artifact_type": "escalation_rule", "title": "DEMO-EVIDENCE-GAPS", "status": "draft", "marketplace": "synthetic-fixture", "jurisdiction": "TEST", "environment_scope": "development-only", "synthetic_demo": true, "locale": "en-IN", "effective_from": "", "effective_to": "", "section_id": "C02", "section_title": "Required operational fact missing", "intents_json": "[]", "categories_json": "[]", "related_policy_ids_json": "[]", "source_uri": "synthetic://agentic-customer-support/DEMO-EVIDENCE-GAPS/1.0.0", "source_path": "knowledge_base/escalation_rules/DEMO-EVIDENCE-GAPS/1.0.0.yaml", "source_file_sha256": "de3b2dd76fe3c31f2b21fa60778b60780cf5840e58eb4eabc02b332ed9c4251f", "content_sha256": "", "content": "Condition: required operational fact missing. Required action: insufficient evidence and human review."}
