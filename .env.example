# Local development defaults only. Production secrets must come from a secret manager.
APP_ENV=local
LOG_LEVEL=INFO
LOG_REDACT_PII=true
API_REQUEST_TIMEOUT_SECONDS=30

# Laya's local HTTP service. Keep the service bound to loopback for development.
LAYA_BASE_URL=http://127.0.0.1:8770
LAYA_ENDPOINT_PATH=/api/predict
LAYA_API_KEY=
LAYA_TIMEOUT_SECONDS=15
LAYA_MIN_CONFIDENCE=0.65
# Optional checkpoint name; leave empty to use the Laya server's router.
LAYA_MODEL=
# Experimental only. Keep disabled until a reviewed, production-representative
# evaluation supports selective routing. The Laya score is not calibrated.
CLASSIFIER_CONSENSUS_ROUTING_ENABLED=false
CLASSIFIER_BASELINE_MIN_CONFIDENCE=0.60
EVIDENCE_MAX_AGE_SECONDS=86400

# Runtime application connection: use the Neon pooled URL.
DATABASE_URL=

# Migration identity: use the Neon direct/unpooled URL only in reviewed migration jobs.
DATABASE_URL_UNPOOLED=

# Separate write-enabled direct URL for explicitly opted-in local fixture seeding.
# Never point this value at a protected production database.
CUSTOMER_CONTEXT_WRITE_DATABASE_URL=
ALLOW_DEVELOPMENT_CONTEXT_SEED=false

# Separate write-enabled Postgres URL for LangGraph checkpoints, proposals and workflow audit.
# Do not point this at the read-only DATABASE_URL. Run scripts/setup_workflow_storage.py once.
WORKFLOW_DATABASE_URL=
WORKFLOW_API_TOKEN=
WORKFLOW_API_ACTOR_ID=local-support-agent
WORKFLOW_REVIEWER_TOKEN=
WORKFLOW_REVIEWER_ID=local-reviewer
WORKFLOW_MIN_CONFIDENCE=0.65
LANGGRAPH_STRICT_MSGPACK=true
WORKFLOW_WORKER_POLL_SECONDS=2
WORKFLOW_JOB_LEASE_SECONDS=180

# Policy retrieval. Keep credentials out of source control.
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=agentic_customer_support_dev_policies_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
POLICY_DATA_DIR=knowledge_base

# Identity provider settings are required before enabling protected endpoints.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_REVIEWER_ROLE=support_reviewer
OIDC_SUPPORT_ROLE=support_agent

# Optional drafting model. Keep disabled until privacy and provider review is complete.
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10
