# EC2 deployment configuration; fill these from your existing setup.
# Copy to .env.ec2 in the project root and keep that file out of source control.
APP_ENV=local
DATABASE_URL=postgresql://REPLACE_WITH_DEVELOPMENT_READONLY_CONNECTION
WORKFLOW_DATABASE_URL=postgresql://REPLACE_WITH_WORKFLOW_DATABASE_CONNECTION
WORKFLOW_API_TOKEN=REPLACE_WITH_LOCAL_SUPPORT_TOKEN
WORKFLOW_REVIEWER_TOKEN=REPLACE_WITH_DIFFERENT_LOCAL_REVIEWER_TOKEN

MILVUS_URI=https://REPLACE_WITH_DEVELOPMENT_MILVUS_ENDPOINT
MILVUS_TOKEN=REPLACE_WITH_DEVELOPMENT_MILVUS_TOKEN
MILVUS_COLLECTION=agentic_customer_support_dev_policies_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO
LOG_REDACT_PII=true

# Groq LLM API Configuration
LLM_ENABLED=false
LLM_PROVIDER=groq
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=10

# Langfuse Observability & Tracing (points to EC2 instance or Cloud)
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_LANGFUSE_SECRET_KEY
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
