# Private synthetic-data investigation demo; fill these from your existing setup.
# Copy to .env.ec2 in the project root and keep that file out of source control.
DATABASE_URL=postgresql://REPLACE_WITH_DEVELOPMENT_READONLY_CONNECTION
MILVUS_URI=https://REPLACE_WITH_DEVELOPMENT_MILVUS_ENDPOINT
MILVUS_TOKEN=REPLACE_WITH_DEVELOPMENT_MILVUS_TOKEN
MILVUS_COLLECTION=agentic_customer_support_dev_policies_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO
LOG_REDACT_PII=true

# This profile serves read-only investigation endpoints. Workflow intake,
# approvals, and durable job processing are not configured here.
LLM_ENABLED=false
