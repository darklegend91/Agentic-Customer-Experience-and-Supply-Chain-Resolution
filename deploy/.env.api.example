# Private demo only: use fictional development records and draft policies.
APP_ENV=local
LOG_LEVEL=INFO
LOG_REDACT_PII=true
API_REQUEST_TIMEOUT_SECONDS=30

# Read-only development Neon connection. Use the pooled endpoint for API reads.
DATABASE_URL=postgresql://REPLACE_ME
# Separate write-enabled workflow/checkpoint database. Do not reuse DATABASE_URL.
WORKFLOW_DATABASE_URL=postgresql://REPLACE_ME

# Development Milvus/Zilliz collection and a least-privilege API credential.
MILVUS_URI=https://REPLACE_ME
MILVUS_TOKEN=REPLACE_ME
MILVUS_COLLECTION=agentic_customer_support_dev_policies_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Laya runs in-process (laya package). No external HTTP service needed.
LAYA_MIN_CONFIDENCE=0.65
CLASSIFIER_CONSENSUS_ROUTING_ENABLED=true
CLASSIFIER_BASELINE_MIN_CONFIDENCE=0.60

# Langfuse LLM Observability & Tracing (set true to enable tracing on EC2 or cloud)
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_LANGFUSE_SECRET_KEY
LANGFUSE_HOST=https://cloud.langfuse.com

# Use two distinct, randomly generated demo-only values.
WORKFLOW_API_TOKEN=REPLACE_WITH_LOCAL_SUPPORT_TOKEN
WORKFLOW_API_ACTOR_ID=local-support-agent
WORKFLOW_REVIEWER_TOKEN=REPLACE_WITH_DIFFERENT_LOCAL_REVIEWER_TOKEN
WORKFLOW_REVIEWER_ID=local-reviewer
WORKFLOW_MIN_CONFIDENCE=0.65
LANGGRAPH_STRICT_MSGPACK=true
WORKFLOW_WORKER_POLL_SECONDS=2
WORKFLOW_JOB_LEASE_SECONDS=180

# Conversational Response Model (Groq or OpenAI-compatible)
LLM_ENABLED=false
LLM_PROVIDER=groq
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=10
